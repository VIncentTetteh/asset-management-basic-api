<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/spring.log}}"/>

    <!--
         %X{requestId} is the correlation id put into MDC by RequestCorrelationIdInterceptor
         and stored on audit_event.request_id. It was previously absent from every pattern,
         so the id existed in memory and in the database but never appeared in a single log
         line — which is precisely where you need it when tracing one request through an
         incident. "-" renders for work outside a request (startup, scheduled jobs).
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:--}] %-5level %logger{36} - %msg%n"/>

    <!-- ── Console appender (plain text — dev/test) ─────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.assetiq.logging.RedactingPatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- ── JSON console appender (production) ──────────────────────────────
         Logback's own JsonEncoder, wrapped with secret redaction. This replaced a
         hand-written PatternLayoutEncoder that escaped only double quotes and so
         emitted invalid JSON for any message containing a newline or backslash —
         stack traces above all. JsonEncoder also serialises MDC as real fields, so
         requestId arrives structured and queryable rather than baked into a string.
    ──────────────────────────────────────────────────────────────────────── -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.assetiq.logging.RedactingJsonEncoder"/>
    </appender>

    <!-- ── Rolling file appender ──────────────────────────────────────────── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <encoder class="com.assetiq.logging.RedactingPatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>10GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- ── Sentry appender ─────────────────────────────────────────────────
         Forwards ERROR-level events to Sentry as issues.
         INFO+ events are attached as breadcrumbs for full context.
    ──────────────────────────────────────────────────────────────────────── -->
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <minimumEventLevel>ERROR</minimumEventLevel>
        <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
    </appender>

    <!-- ── Production profile: JSON console only ──────────────────────── -->
    <springProfile name="prod">
        <logger name="com.assetiq" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="SENTRY"/>
        </logger>
        <root level="WARN">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="SENTRY"/>
        </root>
    </springProfile>

    <!-- ── Non-production profiles: plain text console + file ─────────── -->
    <springProfile name="!prod">
        <logger name="com.assetiq" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="SENTRY"/>
        </logger>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="SENTRY"/>
        </root>
    </springProfile>

</configuration>
