# ══════════════════════════════════════════════════════════════════════════════
# AssetIQ Standalone — environment variables
# Copy this file to .env and fill in every value before running docker compose.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=assetiq
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
APP_JWT_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET
APP_JWT_EXPIRATION=900000
APP_REFRESH_TOKEN_LIFETIME=PT12H
# Generate with: openssl rand -base64 32
APP_DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Your AssetIQ license key — paste the JWT you received after purchase.
# Leave blank on first boot; activate via Settings → License in the web UI.
ASSETIQ_LICENSE_KEY=
LICENSE_SERVER_URL=https://license.assetiq.io

# File storage: "local" stores uploads inside the container volume.
# Set to "s3" and add S3_* vars below to use object storage instead.
STORAGE_TYPE=local

# ── Paystack (optional — used by cloud billing features only) ─────────────────
# Leave blank for a pure offline installation.
PAYSTACK_SECRET_KEY=

# ── TLS ───────────────────────────────────────────────────────────────────────
# Place your certificate files in nginx/certs/ before starting nginx.
# Self-signed certs for local testing:
#   openssl req -x509 -newkey rsa:4096 -keyout nginx/certs/server.key \
#     -out nginx/certs/server.crt -days 365 -nodes -subj "/CN=localhost"

# ── Optional: S3-compatible object storage ────────────────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=    # for MinIO or other S3-compatible stores
