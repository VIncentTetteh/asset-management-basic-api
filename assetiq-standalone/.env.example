# AssetIQ self-hosted — environment reference.
#
# YOU DO NOT NORMALLY WRITE THIS FILE BY HAND. Run ./scripts/bootstrap.sh; it
# generates .env with fresh secrets in the exact formats the application
# validates at startup, and sets it to mode 0600.
#
# This file documents every variable the compose stack reads, so you can see
# what bootstrap produced and what is safe to change afterwards. It contains NO
# real values: every secret below is an empty placeholder, and the stack refuses
# to start rather than fall back to a default for any of them.
#
# Variables marked REQUIRED have no default. `docker compose up` fails
# immediately and names the missing variable.

# ═════════════════════════════════════════════════════════════════════════════
# Release
# ═════════════════════════════════════════════════════════════════════════════

# REQUIRED. The image tag to run, e.g. 1.4.2. Never `latest`: an unattended
# image change is an unattended schema migration.
ASSETIQ_VERSION=

# Container registry holding the AssetIQ images.
ASSETIQ_REGISTRY=public.ecr.aws/assetiq

# ═════════════════════════════════════════════════════════════════════════════
# Public address
# ═════════════════════════════════════════════════════════════════════════════

# REQUIRED. The HTTPS URL users will visit. Becomes the CORS allow-list entry,
# so a mismatch shows up as browser requests failing CORS, not as a server error.
APP_PUBLIC_URL=

# The prod profile rejects localhost/127.0.0.1 as a CORS origin. Set true only
# for an evaluation install reached at localhost; the backend refuses to start
# otherwise. bootstrap.sh sets this for you based on --public-url.
APP_CORS_ALLOW_LOCALHOST=false

# Host ports the TLS edge publishes. Change if something already owns 80/443.
HTTP_PORT=80
HTTPS_PORT=443

# ═════════════════════════════════════════════════════════════════════════════
# Database (PostgreSQL 16)
# ═════════════════════════════════════════════════════════════════════════════

POSTGRES_DB=assetiq
POSTGRES_USER=assetiq

# REQUIRED. Generated by bootstrap.sh as `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# Redis 7
# ═════════════════════════════════════════════════════════════════════════════

# REQUIRED. Generated by bootstrap.sh as `openssl rand -hex 24`.
REDIS_PASSWORD=

# Evicts least-recently-used keys past this. Redis holds rate-limiter counters
# and SSO handshake state here, not durable data.
REDIS_MAXMEMORY=256mb

# ═════════════════════════════════════════════════════════════════════════════
# Application secrets
# ═════════════════════════════════════════════════════════════════════════════

# REQUIRED. HS256 signing secret for access tokens: 64 hex characters
# (`openssl rand -hex 32`). The app refuses to boot on a short or low-entropy
# value. Rotating it logs every user out; it loses no data.
APP_JWT_SECRET=

# Access-token lifetime in milliseconds (900000 = 15 minutes).
APP_JWT_EXPIRATION=900000

# Refresh-session lifetime, ISO-8601 duration.
APP_REFRESH_TOKEN_LIFETIME=PT12H

# REQUIRED. AES-256 field-encryption key: Base64 of exactly 32 random bytes
# (`openssl rand -base64 32`). Encrypts MFA secrets, SSO and webhook secrets and
# gateway tokens.
#
#   BACK THIS UP SEPARATELY FROM THE DATABASE. A database backup restored
#   without this key leaves every encrypted column unreadable, permanently.
#   Changing it has the same effect. There is no recovery path.
APP_DATA_ENCRYPTION_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Licence
# ═════════════════════════════════════════════════════════════════════════════

# Self-hosted entitlement. The key is a self-contained signed document verified
# locally against a public key baked into the image: no licence server, no
# call-home, and an air-gapped install behaves identically to a connected one.
APP_LICENSE_OFFLINE_ENABLED=true

# Your licence key. Leave empty to run on free-tier quotas — everything works,
# the limits are lower. An absent, lapsed or invalid key is never an outage and
# never deletes data; it falls back to the free tier and says so in the log.
APP_LICENSE_OFFLINE_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Email (optional)
# ═════════════════════════════════════════════════════════════════════════════

# With this false, password reset, user invitation and DSAR acknowledgement
# emails are not sent. Users can still be created; they cannot self-serve a
# forgotten password.
APP_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ═════════════════════════════════════════════════════════════════════════════
# Object storage (optional)
# ═════════════════════════════════════════════════════════════════════════════

# READ THIS BEFORE LEAVING IT false.
#
# AssetIQ has NO local-disk storage backend. With S3 disabled, generated
# reports and imports are held in the backend's JVM heap: lost on every
# restart, invisible to a second replica, and never evicted. That is fine for
# evaluation and wrong for production.
#
# The easy fix is the bundled MinIO, which speaks S3 and runs beside the other
# containers:
#
#   docker compose --profile minio up -d
#   docker compose exec minio mc alias set local http://127.0.0.1:9000 \
#     "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   docker compose exec minio mc mb --ignore-existing local/assetiq
#
# then set the five values below and restart the backend.
APP_STORAGE_S3_ENABLED=false
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=us-east-1
# For MinIO: http://minio:9000 with path-style addressing.
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_PATH_STYLE=false
# Credentials for the store above. For MinIO these are the MINIO_ROOT_* values.
# On AWS with an instance profile or IRSA, leave both blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only read when you use `--profile minio`. Generate with `openssl rand -hex 24`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
