### Licence signing material (self-hosted SKU) ###
# The private key is the root of trust for every licence ever issued. It lives
# in a password manager or KMS, never in the tree. The public key is baked into
# release images at build time (see src/main/resources/license/OFFLINE-KEY-README.txt).
licence-keys/
src/main/resources/license/*.pem

### Self-hosted operator secrets generated by the bootstrap script ###
# .env holds the installation's real secrets. .env.example is the documented
# template and IS tracked, so the negation has to cover the bare name too.
assetiq-standalone/.env
assetiq-standalone/.env.*
!assetiq-standalone/.env.example
!assetiq-standalone/.env.*.example

# Self-signed TLS material generated by bootstrap.sh.
assetiq-standalone/nginx/certs/
