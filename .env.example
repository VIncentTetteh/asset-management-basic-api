# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host:5432/your-database-name
SPRING_DATASOURCE_USERNAME=your-database-username
SPRING_DATASOURCE_PASSWORD=your-database-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA / Hibernate
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
# Use "validate" in production once schema is stable (Flyway handles migrations)
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ── Application ───────────────────────────────────────────────────────────────
SPRING_APPLICATION_NAME=assetiq
SERVER_PORT=8085
# "cloud" (SaaS default) or "standalone" (self-hosted, requires license key)
APP_MODE=cloud

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=replace-me-with-a-secure-random-secret-at-least-48-chars
APP_JWT_EXPIRATION=900000
APP_REFRESH_TOKEN_LIFETIME=PT12H
APP_DATA_ENCRYPTION_KEY=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Sentry (error tracking, tracing, metrics) ─────────────────────────────────
# Get your DSN at https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
# Tag events with the environment name shown in Sentry
SENTRY_ENVIRONMENT=production
# Fraction of transactions to trace for performance monitoring (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: set to a git SHA or version string to link events to a release
SENTRY_RELEASE=

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Provider: groq (free) | anthropic (paid) | ollama (local)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Paystack Billing ──────────────────────────────────────────────────────────
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TIMEOUT_SECONDS=30

APP_BILLING_DEFAULT_CURRENCY=GHS
APP_BILLING_BASIC_AMOUNT=9900
APP_BILLING_BUSINESS_AMOUNT=79900
APP_BILLING_BUSINESS_ANNUAL_AMOUNT=862920
# Create plans in Paystack dashboard → Settings → Subscriptions → Plans
APP_BILLING_BASIC_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxx
APP_BILLING_BUSINESS_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxx
APP_BILLING_BUSINESS_ANNUAL_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxx
APP_BILLING_CALLBACK_URL=https://yourdomain.com/billing/verify

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
APP_EMAIL_ENABLED=true
APP_EMAIL_FROM=no-reply@yourdomain.com
APP_EMAIL_FROM_NAME=AssetIQ
APP_EMAIL_BASE_URL=https://yourdomain.com
APP_EMAIL_SUPPORT=support@yourdomain.com
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# ── File storage ──────────────────────────────────────────────────────────────
# Exactly one durable backend must be enabled or the application refuses to
# start. S3 is the supported choice for a hosted, multi-replica deployment; the
# filesystem backend is the default for a single-node self-hosted install.
#
# The directory is created at startup and must be on persistent storage. The
# application refuses to start if it is not writable.
APP_STORAGE_FILESYSTEM_ENABLED=true
APP_STORAGE_FILESYSTEM_BASE_DIR=./data/assetiq-storage

# Heap-backed storage. Tests and throwaway local runs only: files are lost on
# restart. Startup fails if this is true outside a dev/test/local profile.
APP_STORAGE_IN_MEMORY_ENABLED=false

# ── AWS S3 (file storage) ─────────────────────────────────────────────────────
# Set APP_STORAGE_FILESYSTEM_ENABLED=false when you enable this.
APP_STORAGE_S3_ENABLED=false
APP_STORAGE_S3_BUCKET=your-bucket-name
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_PATH_STYLE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com
