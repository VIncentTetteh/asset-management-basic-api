# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://your-database-host/your-database-name
SPRING_DATASOURCE_USERNAME=your-database-username
SPRING_DATASOURCE_PASSWORD=your-database-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate Configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Application Configuration
SPRING_APPLICATION_NAME=demo-assessment
SERVER_PORT=8085

# ===== AI / LLM =====
# Required for POST /api/v1/ai/chat (RAG-powered conversational assistant)
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Paystack Billing
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TIMEOUT_SECONDS=30

# Billing Plan Amounts (in minor currency units, e.g. kobo for NGN)
APP_BILLING_DEFAULT_CURRENCY=GHS
APP_BILLING_BASIC_AMOUNT=2000000
APP_BILLING_PREMIUM_AMOUNT=10000000

# Paystack recurring plan codes — create these in your Paystack dashboard
# (Settings → Subscriptions → Plans) and set the plan_code here
APP_BILLING_BASIC_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxx
APP_BILLING_PREMIUM_PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxxx

# Billing callback URL (redirect after Paystack payment page)
APP_BILLING_CALLBACK_URL=https://yourdomain.com/billing/verify

# CORS
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com
