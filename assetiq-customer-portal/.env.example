# ── Paystack ──────────────────────────────────────────────────────────────────
# From your Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Public key is used client-side (embedded in the Paystack inline script)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# ── License Server ────────────────────────────────────────────────────────────
# URL where assetiq-license-server is reachable from this portal's server process.
# In Docker Compose this is the service name: http://license-server:8090
LICENSE_SERVER_URL=http://license-server:8090
# Must match license.admin.api-key in the license server's application.properties
LICENSE_ADMIN_API_KEY=change-me-in-production

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Create a free account at resend.com and add your domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@assetiq.io

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://portal.assetiq.io
# Secret used to sign short-lived checkout session tokens (openssl rand -hex 32)
CHECKOUT_SESSION_SECRET=change-me-in-production
