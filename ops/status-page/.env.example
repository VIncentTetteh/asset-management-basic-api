# P0-7: Copy to `.env` and fill in for the status-page VM.
# These are NOT baked into the compose file because they rotate often.

# Slack (preferred) or Discord webhook for Uptime Kuma alert fan-out.
# Configure the actual notification channel inside the Kuma admin UI after
# first boot; we only need this here so ops has a canonical place to store it.
STATUS_ALERT_SLACK_WEBHOOK=

# Optional: Pagerduty routing key for high-severity pages.
STATUS_ALERT_PAGERDUTY_KEY=

# Basic-auth credentials for the Kuma admin UI, in case ops wants to front
# /admin with a second factor beyond Kuma's built-in login.
STATUS_ADMIN_BASIC_AUTH_USER=assetiq-ops
STATUS_ADMIN_BASIC_AUTH_PASSWORD_HASH=
